# Runtime template used by ./scripts/bootstrap.sh <environment>. Generated
# values are written below runtime/<environment>/ and never enter Git/images.

COMPOSE_PROJECT_NAME=qy-allpachong
QY_DEPLOYMENT_MODE=fresh-migration
QY_IMAGE_TAG=local
# Optional per-image overrides. Leave empty to inherit QY_IMAGE_TAG.
QYBULLMQ_IMAGE_TAG=
QY_ROTA_CORE_IMAGE_TAG=
QY_ROTA_DASHBOARD_IMAGE_TAG=
QY_FEATURE_ENGINE_IMAGE_TAG=
QY_FEATURE_DISPATCH_IMAGE_TAG=
QY_DASHBOARD_IMAGE_TAG=
QY_AUTH_IMAGE_TAG=
TZ=UTC

# Fresh newcrawler database/runtime networks. Standalone Publication and
# Feature Bridge processes join these same networks.
QY_FRESH_CRAWLER_NETWORK=qy-newcrawler-crawler-runtime
QY_FRESH_BUSINESS_NETWORK=qy-newcrawler-business-database

# Legacy Shared-QY mode reads existing state without starting bundled state or
# writer services. These names are not used by fresh-migration Writers.
QY_SHARED_CRAWLER_NETWORK=bullmq-crawler
QY_SHARED_BUSINESS_NETWORK=yewu_business_network
QY_SHARED_ROTA_NETWORK=youtube-rota-qy-internal
QY_MIGRATION_SOURCE_NETWORK=newcrawler-migration-source
CRAWLER_DB_HOST=crawler-pgbouncer
CRAWLER_DB_PORT=6432
CRAWLER_REDIS_HOST=redis
CRAWLER_REDIS_PORT=6379
CRAWLER_S3_ENDPOINT=http://minio:9000
ROTA_PROXY_BASE_URL=http://rota-core:8000
ROTA_PROXY_CONTROL_URL=http://rota-core:8001/api/v1/proxy-control
QY_NGINX_ROTA_API_UPSTREAM=rota-core:8001
QY_NGINX_ROTA_DASHBOARD_UPSTREAM=rota-dashboard:3000
QY_NGINX_MINIO_CONSOLE_UPSTREAM=minio:9001
QY_SHARED_BUSINESS_AUDIT_DATABASE_URL_FILE=
BUSINESS_AUDITOR_ROLE=business
QY_CHANNEL_WORKER_REPLICAS=20
QY_INCREMENTAL_WORKER_REPLICAS=20

# Public hosts. TLS should terminate in front of the bundled Nginx service.
QY_DASHBOARD_HOST=qydashboard.example.com
QY_BULLMQ_HOST=qybullmq.example.com
QY_ROTA_HOST=qyproxy.example.com
QY_MINIO_HOST=qyminio.example.com
QY_AUTH_COOKIE_DOMAIN=example.com
QY_AUTH_COOKIE_NAME=__Secure-qy_session
QY_PUBLIC_HTTP_PORT=8080
QY_DASHBOARD_ORIGIN=https://qydashboard.example.com
QY_ROTA_PUBLIC_URL=https://qyproxy.example.com

# Fresh newcrawler Crawler PostgreSQL and PgBouncer.
CRAWLER_DB_NAME=newcrawler_crawler
CRAWLER_DB_USER=bullmq
CRAWLER_DB_PASSWORD=CHANGE_ME_CRAWLER_DB_PASSWORD
FEATURE_DB_PASSWORD=CHANGE_ME_FEATURE_DB_PASSWORD
PUBLICATION_DB_PASSWORD=CHANGE_ME_PUBLICATION_DB_PASSWORD
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=40
CRAWLER_POSTGRES_VOLUME_NAME=qy-newcrawler-crawler-postgres-20260824-v1

# Read-only legacy Migration Source. Resolve MIGRATION_POSTGRES_DATABASE_OID
# with the documented read-only preflight before starting API or Dashboard.
MIGRATION_SOURCE_ID=qy-migration-v1
MIGRATION_POSTGRES_HOST=migration-postgres
MIGRATION_POSTGRES_PORT=6432
MIGRATION_POSTGRES_DB=bullmq_crawler_migration
MIGRATION_POSTGRES_DATABASE_OID=0
MIGRATION_POSTGRES_USER=migration_reader
MIGRATION_POSTGRES_PASSWORD=CHANGE_ME_MIGRATION_DB_PASSWORD

# BullMQ Redis and MinIO.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
MINIO_ROOT_USER=crawler
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET=newcrawler-raw-20260824-v1
CRAWLER_REDIS_VOLUME_NAME=qy-newcrawler-redis-20260824-v1
CRAWLER_MINIO_VOLUME_NAME=qy-newcrawler-minio-20260824-v1

# Rota database and worker control.
ROTA_DB_NAME=rota
ROTA_DB_USER=rota
ROTA_DB_PASSWORD=CHANGE_ME_ROTA_DB_PASSWORD
ROTA_ADMIN_USER=admin
ROTA_ADMIN_PASSWORD=CHANGE_ME_ROTA_ADMIN_PASSWORD
ROTA_PROXY_CONTROL_TOKEN=CHANGE_ME_ROTA_PROXY_CONTROL_TOKEN
ROTA_BULLMQ_PROXY_PASSWORD=CHANGE_ME_ROTA_BULLMQ_PROXY_PASSWORD
ROTA_WORKLOAD_SCOPE=qy-production
ROTA_DISCOVER_SLOTS=2
ROTA_CHANNEL_SLOTS=40
ROTA_QUERY_QUALITY_SLOTS=1
ROTA_DETAIL_SLOTS=0
ROTA_PROXY_HOST_PORT=19284

# Business projection database and publication transport.
BUSINESS_DB_NAME=newcrawler_business
BUSINESS_DB_USER=business
BUSINESS_DB_PASSWORD=CHANGE_ME_BUSINESS_DB_PASSWORD
BUSINESS_PUBLICATION_INGRESS_DB_PASSWORD=CHANGE_ME_BUSINESS_PUBLICATION_INGRESS_DB_PASSWORD
BUSINESS_PUBLICATION_RECONCILER_DB_PASSWORD=CHANGE_ME_BUSINESS_PUBLICATION_RECONCILER_DB_PASSWORD
BUSINESS_PUBLICATION_PROJECTOR_DB_PASSWORD=CHANGE_ME_BUSINESS_PUBLICATION_PROJECTOR_DB_PASSWORD
BUSINESS_PUBLICATION_INGRESS_TOKEN=CHANGE_ME_PUBLICATION_INGRESS_TOKEN
PUBLICATION_DESTINATION=business
PUBLICATION_STREAM_ID=CHANGE_ME_PUBLICATION_STREAM_ID
PUBLICATION_SOURCE_DEPLOYMENT_KEY=newcrawler-fresh-20260824-v1
PUBLICATION_SOURCE_IDENTITY_JSON={"database":"newcrawler_crawler","deployment":"newcrawler-fresh-20260824-v1"}
PUBLICATION_BOOTSTRAP_PROJECTION_MODE=online
PUBLICATION_OPERATOR=newcrawler-fresh-bootstrap
PUBLICATION_ACTION_REASON=controlled-newcrawler-fresh-database-bootstrap
PUBLICATION_WRITER_DEPLOYMENT_REF=sha256:CHANGE_ME_PUBLICATION_WRITER_DEPLOYMENT_DIGEST
PUBLICATION_RUNTIME_DEPLOYMENT_REF=sha256:CHANGE_ME_PUBLICATION_RUNTIME_DEPLOYMENT_DIGEST
BUSINESS_POSTGRES_VOLUME_NAME=qy-newcrawler-business-postgres-20260824-v1

# Crawler policy. Worker replicas are selected at startup with --scale.
YOUTUBE_LANGUAGE=pt-BR
YOUTUBE_CONTROL_LANGUAGE=en
YOUTUBE_COUNTRY=BR
BROWSER_PROFILE_TIMEZONE=America/Sao_Paulo
MIN_SUBSCRIBER_COUNT=1000
YOUTUBE_CHANNEL_CONTENT_LIMIT=30
YOUTUBE_CONTENT_MAX_AGE_DAYS=90
YTDLP_COMMENT_FIRST_PAGE_MAX=20
YOUTUBE_DATA_API_KEYS=
INCREMENTAL_AGENT_CONFIG_ID=0

# Daily clock and dynamic dispatch.
SCHEDULER_DAILY_HOUR_UTC=0
SCHEDULER_DAILY_MINUTE_UTC=30
SCHEDULER_PLAYER_CAP=20
SCHEDULER_NEXT_CAP=8
SCHEDULER_MAX_PLANS=100000
FEATURE_INGEST_TOKEN=CHANGE_ME_FEATURE_INGEST_TOKEN

# Auth bootstrap. The initial password is generated separately and is never
# stored in this file. Override the username before running bootstrap if needed.
QY_AUTH_USERNAME=admin
