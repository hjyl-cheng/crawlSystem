# Full node execution image, built independently of the center's services.
ARG GO_IMAGE=golang:1.25.3-bookworm
ARG NODE_IMAGE=node:20-bookworm-slim
FROM ${GO_IMAGE} AS relay
WORKDIR /src
ENV GOMAXPROCS=2 GOMEMLIMIT=384MiB
COPY services/rota/core/go.mod services/rota/core/go.sum ./
RUN go mod download
COPY services/rota/core .
RUN CGO_ENABLED=0 go build -p 2 -trimpath -ldflags="-s -w" -o /out/node-forward ./cmd/node-forward

FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=UTC YOUTUBEJS_EXTRACTOR_MODE=full
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
COPY services/qybullmq/package.json services/qybullmq/package-lock.json ./
RUN npm ci --omit=dev
COPY services/remote-node/requirements-collect.txt /tmp/requirements.txt
RUN pip3 install --break-system-packages --no-cache-dir -r /tmp/requirements.txt
COPY --from=relay /out/node-forward /usr/local/bin/node-forward
COPY services/qybullmq/src ./src
COPY services/qybullmq/scripts/fingerprint_gateway.py services/qybullmq/scripts/runRemoteNodeIncremental.mjs ./scripts/
ARG QY_VCS_REF=uncommitted
LABEL org.opencontainers.image.title="qy-remote-node-incremental" \
      org.opencontainers.image.revision="${QY_VCS_REF}" qy.remote.mode="incremental_collect" \
      qy.remote.runtime="youtubejs-incremental-v1"
USER 1000:1000
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 CMD ["node","scripts/runRemoteNodeIncremental.mjs","--healthcheck"]
CMD ["node","scripts/runRemoteNodeIncremental.mjs"]
