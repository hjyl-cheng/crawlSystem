FROM golang:1.25.3-bookworm AS build
WORKDIR /src
ENV GOMAXPROCS=2 GOMEMLIMIT=384MiB
COPY services/rota/core/go.mod services/rota/core/go.sum ./
RUN go mod download
COPY services/rota/core .
RUN CGO_ENABLED=0 go build -p 2 -trimpath -ldflags="-s -w" -o /out/remote-route ./cmd/remote-route
FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/remote-route /usr/local/bin/remote-route
USER 65532:65532
CMD ["remote-route"]
