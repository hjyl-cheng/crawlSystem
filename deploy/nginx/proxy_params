proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $original_proto;
proxy_set_header X-Original-Host $host;
proxy_set_header X-Original-Proto $original_proto;
proxy_set_header X-Original-URI $request_uri;
proxy_set_header X-Original-Method $request_method;
proxy_set_header X-Original-Origin $http_origin;
proxy_set_header X-Original-Referer $http_referer;
proxy_set_header X-Original-Fetch-Dest $http_sec_fetch_dest;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_read_timeout 3600s;
proxy_send_timeout 3600s;
