map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $original_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

upstream qy_dashboard { server dashboard:3000; }
upstream qy_bullmq { server qybullmq-api:3000; }
upstream qy_auth { server auth:3000; }
upstream qy_rota_api { server ${QY_ROTA_API_UPSTREAM}; }
upstream qy_rota_dashboard { server rota-dashboard:3000; }
upstream qy_minio_console { server ${QY_MINIO_CONSOLE_UPSTREAM}; }

server {
    listen 80;
    server_name ${QY_DASHBOARD_HOST};

    location /login { proxy_pass http://qy_auth; include /etc/nginx/proxy_params; }
    location /auth/ { proxy_pass http://qy_auth; include /etc/nginx/proxy_params; }
    location = /_auth {
        internal;
        proxy_pass http://qy_auth/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Host $host;
        proxy_set_header X-Original-Proto $original_proto;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-Origin $http_origin;
        proxy_set_header X-Original-Referer $http_referer;
        proxy_set_header X-Original-Fetch-Dest $http_sec_fetch_dest;
        proxy_set_header X-Auth-Renew "1";
        proxy_set_header X-Client-IP $remote_addr;
    }
    location / {
        auth_request /_auth;
        error_page 401 = @login;
        auth_request_set $qy_auth_user $upstream_http_x_authenticated_user;
        auth_request_set $qy_auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $qy_auth_cookie always;
        proxy_set_header X-Authenticated-User $qy_auth_user;
        proxy_pass http://qy_dashboard;
        include /etc/nginx/proxy_params;
    }
    location @login {
        return 302 https://${QY_DASHBOARD_HOST}/login?return_to=https://$host$request_uri;
    }
}

