map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $original_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

resolver 127.0.0.11 valid=10s ipv6=off;

upstream qy_beszel {
    zone qy_beszel 64k;
    server beszel:8090 resolve;
}

upstream qy_dashboard {
    zone qy_dashboard 64k;
    server dashboard:3000 resolve;
}
upstream qy_bullmq {
    zone qy_bullmq 64k;
    server qybullmq-api:3000 resolve;
}
upstream qy_auth {
    zone qy_auth 64k;
    server auth:3000 resolve;
}
upstream qy_rota_api {
    zone qy_rota_api 64k;
    server ${QY_ROTA_API_UPSTREAM} resolve;
}
upstream qy_rota_dashboard {
    zone qy_rota_dashboard 64k;
    server ${QY_ROTA_DASHBOARD_UPSTREAM} resolve;
}
upstream qy_minio_console {
    zone qy_minio_console 64k;
    server ${QY_MINIO_CONSOLE_UPSTREAM} resolve;
}

server {
    listen 80;
    server_name ${QY_DASHBOARD_HOST};

    # Agents authenticate using their per-node Beszel token and the Hub key.
    # Do not expose the Hub UI, PocketBase APIs, or bypass Dashboard login.
    location = /node-monitoring/api/beszel/agent-connect {
        proxy_pass http://qy_beszel/api/beszel/agent-connect;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        access_log off;
    }
    location /login { proxy_pass http://qy_auth; include /etc/nginx/proxy_params; }
    location /auth/ { proxy_pass http://qy_auth; include /etc/nginx/proxy_params; }
    location = /_auth {
        internal;
        proxy_pass http://qy_auth/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Host $host;
        proxy_set_header X-Original-Proto $original_proto;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-Origin $http_origin;
        proxy_set_header X-Original-Referer $http_referer;
        proxy_set_header X-Original-Fetch-Dest $http_sec_fetch_dest;
        proxy_set_header X-Auth-Renew "1";
        proxy_set_header X-Client-IP $remote_addr;
    }
    location / {
        auth_request /_auth;
        error_page 401 = @login;
        auth_request_set $qy_auth_user $upstream_http_x_authenticated_user;
        auth_request_set $qy_auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $qy_auth_cookie always;
        proxy_set_header X-Authenticated-User $qy_auth_user;
        proxy_pass http://qy_dashboard;
        include /etc/nginx/proxy_params;
    }
    location @login {
        return 302 https://${QY_DASHBOARD_HOST}/login?return_to=https://$host$request_uri;
    }
}

